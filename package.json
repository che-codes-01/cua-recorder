{
  "name": "cua-recorder",
  "version": "1.0.0",
  "description": "Record mouse + keyboard actions on your local machine and export a CUA workflow JSON",
  "bin": {
    "cua-record": "dist/index.js"
  },
  "files": [
    "dist/",
    "scripts/",
    "README.md"
  ],
  "scripts": {
    "dev":   "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "blessed":  "^0.1.81",
    "open":     "^10.1.0"
  },
  "devDependencies": {
    "@types/blessed": "^0.1.25",
    "@types/node":    "^20.14.0",
    "tsx":            "^4.15.0",
    "typescript":     "^5.4.5"
  }
}
