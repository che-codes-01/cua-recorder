{
  "name": "cua-recorder",
  "version": "1.1.0",
  "description": "Browser-based recorder for CUA workflows — record mouse + keyboard, export workflow JSON",
  "bin": {
    "cua-record": "dist/index.js"
  },
  "files": [
    "dist/",
    "src/ui.html",
    "scripts/",
    "README.md"
  ],
  "scripts": {
    "dev":       "tsx src/index.ts",
    "build":     "tsc",
    "postbuild": "node -e \"require('fs').copyFileSync('src/ui.html', 'dist/ui.html')\"",
    "start":     "node dist/index.js"
  },
  "dependencies": {
    "open": "^10.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx":         "^4.15.0",
    "typescript":  "^5.4.5"
  }
}
